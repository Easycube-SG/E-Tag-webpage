# =============================================================================
# LOCAL SETUP — copy this file to `.env.local` and paste your values below.
#   cp .env.example .env.local
# Run: npm run dev:api  →  http://localhost:3001
#
# VERCEL — Project → Settings → Environment Variables (Production + Preview):
#   Same variable names. Mark STRIPE_SECRET_KEY and STRIPE_PRICE_PILOT_DEPOSIT
#   as Sensitive. Redeploy after changes (required for VITE_* at build time).
#
# Do NOT run `vercel env pull .env.local` without backing up — it overwrites
# manual secrets (Sensitive vars are not in Development scope).
# =============================================================================

# --- 1. Stripe API keys ---
# Dashboard → Developers → API keys (use test keys while sandboxing)
STRIPE_SECRET_KEY=sk_test_PASTE_YOUR_SECRET_KEY_HERE
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_PASTE_YOUR_PUBLISHABLE_KEY_HERE

# --- 2. Pilot registration deposit (ONE-TIME price, not monthly) ---
# Dashboard → Products → Add product:
#   Name:  Easycube TAG Pilot — Registration deposit
#   Price: SGD 20.00, billing: One time
# Copy the Price ID (starts with price_, NOT prod_)
STRIPE_PRICE_PILOT_DEPOSIT=price_PASTE_YOUR_ONE_TIME_PRICE_ID_HERE

# --- 3. Site URL (Stripe checkout return_url) ---
# Local dev:  http://localhost:3001
# Production: https://easycubesg.com  (Vercel Production only — leave unset on Preview)
SITE_URL=http://localhost:3001

# --- 4. Optional: webhooks (not required for checkout to work) ---
# Dashboard → Developers → Webhooks → endpoint /api/stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_PASTE_YOUR_WEBHOOK_SECRET_HERE

# --- 5. Rate limiting (Upstash Redis — recommended for Production + Preview) ---
# Create a free database at https://console.upstash.com/
# Vercel Integration: Marketplace → Upstash → connect project (auto-fills vars)
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# If unset, rate limiting is skipped (local dev OK; set on Vercel for production).

# --- 6. Frontend display (pricing / pilot trial copy) ---
VITE_PILOT_DEPOSIT_SGD=20
VITE_PILOT_PARCEL_CENTS=2
VITE_STANDARD_PARCEL_CENTS=3
VITE_PILOT_TAG_UNIT_PRICE_SGD=1
VITE_STANDARD_TAG_UNIT_PRICE_SGD=3
